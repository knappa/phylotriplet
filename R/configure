#!/bin/sh
# Configure script for the phylotriplet R package.
# Detects the phylotriplet C++ headers and Eigen3, then writes src/Makevars.

# --- phylotriplet headers ------------------------------------------------
# In a packaged/CI build the workflow copies headers into inst/include/.
# In a monorepo dev build they live two levels up from src/.
if [ -d "inst/include/phylotriplet" ]; then
    PHYLOTRIPLET_INC="-I../inst/include"
else
    PHYLOTRIPLET_INC="-I../../include"
fi

# --- LBFGSpp headers ----------------------------------------------------
if [ -d "inst/include/LBFGSpp" ]; then
    LBFGSPP_INC="-I../inst/include"
elif [ -d "../third_party/LBFGSpp" ]; then
    LBFGSPP_INC="-I../../third_party/LBFGSpp"
else
    LBFGSPP_INC=""
    echo "WARNING: LBFGSpp headers not found." >&2
fi

# --- Eigen3 headers ------------------------------------------------------
# Priority: EIGEN3_INCLUDE_DIR env var > pkg-config > common installation paths
if [ -n "${EIGEN3_INCLUDE_DIR}" ]; then
    EIGEN3_INC="-I${EIGEN3_INCLUDE_DIR}"
elif pkg-config --exists eigen3 2>/dev/null; then
    EIGEN3_INC=$(pkg-config --cflags eigen3)
else
    EIGEN3_INC=""
    for d in \
        /usr/include/eigen3 \
        /usr/local/include/eigen3 \
        /opt/homebrew/opt/eigen/include/eigen3 \
        /opt/homebrew/include/eigen3 \
        /opt/local/include/eigen3; do
        if [ -f "${d}/Eigen/Dense" ]; then
            EIGEN3_INC="-I${d}"
            break
        fi
    done
fi

if [ -z "${EIGEN3_INC}" ]; then
    echo "ERROR: Eigen3 headers not found." >&2
    echo "  Install libeigen3-dev (Debian/Ubuntu) or brew install eigen (macOS)," >&2
    echo "  or set EIGEN3_INCLUDE_DIR to the directory containing Eigen/Dense." >&2
    exit 1
fi

# --- OpenMP -------------------------------------------------------------
OMP_CFLAGS=""
OMP_LIBS=""

case "$(uname)" in
  Darwin)
    # Apple Clang needs libomp (brew install libomp); it does not ship with
    # a working -fopenmp out of the box.  `brew --prefix libomp` reports the
    # path the formula would occupy whether or not it is installed, so each
    # candidate counts only once omp.h is actually present under it.
    BREW_OMP_PREFIX=""
    if command -v brew >/dev/null 2>&1; then
      BREW_OMP_PREFIX="$(brew --prefix libomp 2>/dev/null)"
    fi

    OMP_PREFIX=""
    for d in "${BREW_OMP_PREFIX}" /opt/homebrew/opt/libomp /usr/local/opt/libomp; do
      if [ -n "${d}" ] && [ -f "${d}/include/omp.h" ]; then
        OMP_PREFIX="${d}"
        break
      fi
    done

    if [ -n "${OMP_PREFIX}" ]; then
      OMP_CFLAGS="-Xpreprocessor -fopenmp -I${OMP_PREFIX}/include"
      OMP_LIBS="-L${OMP_PREFIX}/lib -lomp"
      echo "* OpenMP (macOS):       ${OMP_PREFIX}"
    else
      echo "WARNING: libomp not found; building without OpenMP." >&2
      echo "  Install with: brew install libomp" >&2
    fi
    ;;
  *)
    # Linux and other Unix: GCC/Clang with -fopenmp
    OMP_CFLAGS="-fopenmp"
    OMP_LIBS="-lgomp"
    echo "* OpenMP (Linux):       -fopenmp / -lgomp"
    ;;
esac

echo "* phylotriplet headers: ${PHYLOTRIPLET_INC}"
echo "* LBFGSpp headers:     ${LBFGSPP_INC}"
echo "* Eigen3 headers:       ${EIGEN3_INC}"

sed \
    -e "s|@PHYLOTRIPLET_INC@|${PHYLOTRIPLET_INC}|g" \
    -e "s|@LBFGSPP_INC@|${LBFGSPP_INC}|g" \
    -e "s|@EIGEN3_INC@|${EIGEN3_INC}|g" \
    -e "s|@OMP_CFLAGS@|${OMP_CFLAGS}|g" \
    -e "s|@OMP_LIBS@|${OMP_LIBS}|g" \
    src/Makevars.in > src/Makevars
