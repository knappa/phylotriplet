# Locate phylotriplet C++ headers.
# In a packaged build (R CMD check / CI), headers are copied into inst/include/
# by the workflow. In monorepo dev builds, fall back to ../../include/.
PHYLOTRIPLET_INC = $(shell \
  if test -d ../inst/include/phylotriplet; then \
    echo "-I../inst/include"; \
  else \
    echo "-I../../include"; \
  fi)

# Locate Eigen3 headers.
# Priority: EIGEN3_INCLUDE_DIR env var > pkg-config > common paths
ifdef EIGEN3_INCLUDE_DIR
  EIGEN3_INC = -I$(EIGEN3_INCLUDE_DIR)
else
  EIGEN3_INC = $(shell pkg-config --cflags eigen3 2>/dev/null || \
    for d in /usr/include/eigen3 /usr/local/include/eigen3 \
              /opt/homebrew/opt/eigen/include/eigen3 \
              /opt/homebrew/include/eigen3 /opt/local/include/eigen3; do \
      test -f $$d/Eigen/Dense && echo "-I$$d" && break; \
    done)
endif

PKG_CXXFLAGS = $(PHYLOTRIPLET_INC) $(EIGEN3_INC)